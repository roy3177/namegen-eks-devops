# Template — copy to mongodb-secret.yaml (gitignored) before applying:
#   cp mongodb-secret.yaml.example mongodb-secret.yaml
# Edit the values below first if you don't want the assignment's example
# credentials. stringData lets us write plain text here — Kubernetes
# base64-encodes it into the Secret itself.
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-credentials
  namespace: namegen
  labels:
    app: namegen
    component: database
type: Opaque
stringData:
  username: genuser
  password: password
  # Full connection string used by the app. authSource=admin is required
  # because MONGO_INITDB_ROOT_USERNAME/PASSWORD creates this user in the
  # admin database (the assignment's tip URL omits it, but MongoDB needs
  # it to authenticate correctly against a root user).
  MONGODB_URL: mongodb://genuser:password@mongodb-service.namegen.svc.cluster.local:27017/namegen?authSource=admin
